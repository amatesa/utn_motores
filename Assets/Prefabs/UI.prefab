--- !u!114 &8403453567830436058
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7663709965159046507}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57fca48f2249429ca20c769dfb0e3443, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroBookSequence
  bookUI: {fileID: 3199257795248271038}
  playerInputs: {fileID: 0}
  behavioursToDisableWhileOpen:
  - {fileID: 0}
  - {fileID: 0}
  objectsToHideWhileOpen:
  - {fileID: 1171840577450441098}
  pages:
  - pageText: "ORFANATO SANTA CLARA \u2014 1968\r\n\r\nDurante d\xE9cadas, el orfanato
      permaneci\xF3 aislado del pueblo cercano.\r\n\r\nLos habitantes evitaban acercarse
      al edificio despu\xE9s del anochecer."
    pageImage: {fileID: -488821690, guid: f866fde9597402848a8f83337a1be0b6, type: 3}
  - pageText: "Los ni\xF1os hablaban de susurros detr\xE1s de las paredes.\r\n\r\nDec\xEDan
      que las luces se apagaban antes de que alguien desapareciera.\n\nAlgunos empleados
      aseguraban escuchar pasos durante la madrugada."
    pageImage: {fileID: 584716063, guid: 8fb8ab5925841e14b80a42d20ba63887, type: 3}
  - pageText: "Otros afirmaban haber visto una figura recorriendo el segundo piso.\n\nVarios
      ni\xF1os desaparecieron sin dejar rastro.\r\n\r\nNunca se encontraron cuerpos."
    pageImage: {fileID: 584716063, guid: 8fb8ab5925841e14b80a42d20ba63887, type: 3}
  - pageText: "El informe final nunca fue completado.\r\n\nLos registros oficiales
      fueron archivados poco tiempo despu\xE9s.\n\r\nNadie volvi\xF3 a hablar de
      lo ocurrido all\xED. "
    pageImage: {fileID: 584716063, guid: 8fb8ab5925841e14b80a42d20ba63887, type: 3}
  closeAction: {fileID: 0}
  nextPageAction: {fileID: 0}
  previousPageAction: {fileID: 0}
  allowEscapeKeyClose: 1
  unlockCursorWhileOpen: 1
  restoreLockedCursorOnClose: 1
  openOnStart: 1
  onSequenceClosed:
    m_PersistentCalls:
      m_Calls: []
  logDebugMessages: 0
